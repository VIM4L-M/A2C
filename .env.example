# A2C - AI to Completion: backend configuration
# Copy to .env (repository root) for local use. On Render, set these in the dashboard.
# Never commit .env.

# --- Server -----------------------------------------------------------------
# Local default: 127.0.0.1. Render sets PORT and the server binds 0.0.0.0 automatically
# (NODE_ENV=production or RENDER is set). A public bind REQUIRES A2C_USERS and ALLOWED_EXTENSION_ORIGIN.
PORT=8787
HOST=
NODE_ENV=development

# Exact extension origin, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop (see chrome://extensions)
ALLOWED_EXTENSION_ORIGIN=

# Users allowed to call the backend: userId:sha256(token), comma separated.
# Create one with: npm run token -- alice   (empty = local single-user mode, localhost only)
A2C_USERS=
RATE_LIMIT_PER_MINUTE=60

# --- Gemma 4 (primary AI) ----------------------------------------------------
# Any OpenAI-compatible server running Gemma 4 (the part before /chat/completions).
# Verified on this project's dev machine: Ollama + Gemma 4 E4B
#   ollama pull hf.co/google/gemma-4-E4B-it-qat-q4_0-gguf
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_MODEL=hf.co/google/gemma-4-E4B-it-qat-q4_0-gguf
# Only if your provider needs one (e.g. Hugging Face Inference Endpoint token). Stays on the server.
GEMMA_API_KEY=
GEMMA_JSON_MODE=true
GEMMA_MERGE_SYSTEM_PROMPT=false
GEMMA_TIMEOUT_MS=180000
GEMMA_MAX_TOKENS=2048
GEMMA_MAX_RETRIES=1

# --- Backboard.io (optional, opt-in cloud memory) ----------------------------
# Create a key at app.backboard.io -> Settings -> API Keys.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# --- Fine-tuned mapping specialist (optional, experimental) ------------------
# OpenAI-compatible endpoint serving the Tinker-trained checkpoint, if you deploy one.
SPECIALIST_BASE_URL=
SPECIALIST_MODEL=
SPECIALIST_API_KEY=

# --- Tinker (training only; never needed for form filling, never sent to the browser) ---
TINKER_API_KEY=
