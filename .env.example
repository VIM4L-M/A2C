# ContextFill AI - Gemma proxy configuration
# Copy to .env (repository root) and adjust. Never commit .env.

# Where the proxy listens. Keep it on loopback: the proxy is unauthenticated.
HOST=127.0.0.1
PORT=8787

# OpenAI-compatible base URL of the server that runs Gemma 4 (the part before /chat/completions).
# These must match YOUR inference server. Examples (see README "Connecting Gemma 4"):
#   llama.cpp llama-server : http://127.0.0.1:8080/v1
#   Ollama                 : http://127.0.0.1:11434/v1
#   vLLM                   : http://127.0.0.1:8000/v1
#   HF Inference Endpoint  : https://<your-endpoint>.endpoints.huggingface.cloud/v1
GEMMA_BASE_URL=

# Exact model id your server expects. Hugging Face repo verified on 2026-10-16: google/gemma-4-E4B-it
# Ollama example: hf.co/google/gemma-4-E4B-it-qat-q4_0-gguf
GEMMA_MODEL=

# Only if your provider needs it (e.g. a Hugging Face token for an Inference Endpoint).
# Stays on this machine; never sent to the browser extension.
GEMMA_API_KEY=

# Send response_format {"type":"json_object"} (automatically retried without it on HTTP 400).
GEMMA_JSON_MODE=true
# Fold the system prompt into the first user message (for servers whose Gemma template rejects "system").
GEMMA_MERGE_SYSTEM_PROMPT=false
GEMMA_TIMEOUT_MS=90000
GEMMA_MAX_TOKENS=2048

# Comma-separated extension origins allowed to call the proxy, e.g. chrome-extension://<32-letter id>
# Empty = any chrome-extension:// origin (development only).
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
